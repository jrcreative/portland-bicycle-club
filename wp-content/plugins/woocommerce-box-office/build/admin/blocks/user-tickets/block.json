{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "woocommerce-box-office/user-tickets",
  "version": "0.1.0",
  "title": "User Tickets",
  "category": "woocommerce-box-office",
  "icon": "tickets-alt",
  "description": "WooCommerce Box Office block to display tickets purchased by the current user.",
  "example": {},
  "supports": {
    "html": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "My Tickets"
    },
    "description": {
      "type": "string",
      "default": "View or edit each of your purchased tickets using the links below."
    },
    "format": {
      "type": "string",
      "default": "flat"
    },
    "numberOfTickets": {
      "type": "number",
      "default": -1
    }
  },
  "textdomain": "woocommerce-box-office",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}