{% extends 'base.html.twig' %}
    {% block content %}
        <section class="news">
            <div class="grid-container">
                <div class="grid-x grid-padding-x">
                    <div class="cell title"><h1>{% if title is defined %}{{ title }}{% endif %}</h1></div>
                    <div class="cell">
                        {% if desc is defined %}
                            {{ desc }}
                        {% elseif topics is defined %}
                            <div class="button-group"><ul class="dropdown menu" data-dropdown-menu>
                                <li class="is-dropdown-submenu-parent"><a class="hollow button" href="#">Select Topic</a><ul class="menu">
                                    {{ topics }}
                                </ul></li>
                            </ul></div>
                        {% endif %}
                    </div>
                {% if return_url is defined %}
                    <div class="cell">
                        <div class="button-group">
                            <a class="hollow button" href="{{ return_url }}"><i class="fa fa-angle-left" aria-hidden="true"></i> Back</a>
                        </div>
                    </div>
                {% endif %}
                </div>
                <div class="grid-x grid-padding-x small-up-1 medium-up-2 large-up-4">
                    {% for post in posts %}
                        <div class="cell">
                            {% include 'teasers/post.html.twig' %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% include 'partials/pagination.html.twig' %}
        </section>
{% endblock %}
