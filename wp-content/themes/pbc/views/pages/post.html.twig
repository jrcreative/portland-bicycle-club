{% extends 'base.html.twig' %}
{% block content %}
    <section class="one-col-section">
        <div class="background"></div>
        <div class="row">
            <article class="small-12 columns content">
                <h1>{{ post.title }}</h1>
                {% if display_post_author %}
                    {{ fn('get_avatar', post.author.id, 150) }}
                    <p><span>By</span> {{ post.author.name }} <span>&bull;</span> {{ post.date }}</p>
                {% endif %}
                {% if filter_post_content %}
                    {{ fn('wp_kses', post.content, allowed_html_tags) }}
                {% else %}
                    {{ post.content }}
                {% endif %}
                {% if images is defined %}
                    <div class="callout">
                        <h5>{{ callout_label }}</h5>
                        <div class="slick text-center">
                        {% for image in images %}
                            <div>
                                <img src="{{ image.image.url }}" alt="{{ image.image.alt }}">
                            </div>
                        {% endfor %}
                        </div>
                    </div>
                {% endif %}
                {% if documents is defined %}
                    <div class="callout">
                        <h5>{{ callout_label }}</h5>
                        {% for document in documents %}
                            <div>
                                <a href="{{ document.document.url }}">{{ document.document.filename }}</a>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if user and post.post_status == 'publish' %}
                    <div class="comment-box">
                        <!-- comments -->
                        <div class="comments">
                            {% if post.comments %}
                                <h3>Comments </h3>
                                {% for cmt in post.comments %}
				                    {% if cmt.comment_approved %}
                                    	{% include "partials/comment.twig" with {comment:cmt} %}
				                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        </div>

                        {% if post.comment_status == "closed" %}
                            <p>Comments for this post are closed.</p>
                        {% elseif comments is defined and not comments %}
                            <p>You are not allowed to comment on this post.</p>
                        {% else %}
                            <!-- comment form -->
                            {% include "partials/comment-form.twig" %}
                        {% endif %}
                    </div>
                {% endif %}
            </article>
        </div>
    </section>
{% endblock %}